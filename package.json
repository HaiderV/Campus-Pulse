{
  "name": "campus-pulse",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "College feedback sentiment analysis",
  "scripts": {
    "postinstall": "node scripts/vendor.mjs",
