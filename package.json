    "lucide": "^1.62.0",
    "ml-logistic-regression": "^2.0.0",
    "ml-matrix": "^6.12.1",
    "natural": "^8.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
